# Copy to .env for local development (netlify dev loads it automatically).
# In production set these in Netlify: Site configuration -> Environment variables.

# REQUIRED in production. Long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. If set, only people who know this code can create streamer accounts.
# Leave empty and anyone can sign up as a streamer.
STREAMER_INVITE_CODE=

# Tips via Stripe Checkout. Keys: https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=
TIP_CURRENCY=usd

# Branding (name shown in the header). Not SITE_NAME, which Netlify reserves for the subdomain.
BRAND_NAME=Violet

# Optional: run your own PeerJS signaling server instead of the free public one.
# PEER_HOST=peer.example.com
# PEER_PORT=443
# PEER_PATH=/
# PEER_KEY=peerjs

# Optional: TURN server so viewers behind strict firewalls/NATs can connect.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional bootstrap account, created automatically the first time the site is used
# (so you can log in on a fresh deploy without signing up). SEED_ROLE is streamer or viewer.
# Changing SEED_PASSWORD later resets that account's password.
SEED_USERNAME=
SEED_PASSWORD=
SEED_DISPLAY_NAME=
SEED_ROLE=streamer
